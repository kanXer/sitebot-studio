# ==========================================================
# SiteBot Studio Environment Configuration Template
# Duplicate this file to .env and insert your real production API keys
# ==========================================================

# Public Website / Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection URI (Standard non-SRV connection string or MongoDB Atlas SRV)
MONGODB_URI=mongodb://user:password@cluster0.xxxxx.mongodb.net:27017/?ssl=true&authSource=admin

# Qdrant Vector Database
QDRANT_URL=https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Default AI Models Configuration
DEFAULT_CHAT_PROVIDER=nvidia
DEFAULT_CHAT_MODEL=meta/muse-glimmer-30b
DEFAULT_EMBED_PROVIDER=nvidia
DEFAULT_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Multi-Provider LLM & Embedding API Keys
OPENAI_API_KEY=sk-proj-yourOpenAiKeyHere
NVIDIA_API_KEY=nvapi-yourNvidiaNimApiKeyHere
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
OPENROUTER_API_KEY=sk-or-v1-yourOpenRouterApiKeyHere

# ==========================================================
# Firebase Authentication & Client Configuration
# Get these credentials from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyFirebaseApiKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sitebot-studio-dummy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sitebot-studio-dummy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sitebot-studio-dummy.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ==========================================================
# Super Administrator Access & Permissions
# Single email address granted permanent Super Admin privileges
# ==========================================================
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ==========================================================
# Smtp / Email Lead Notifications
# Raw SMTP connection used to email you whenever a visitor submits a lead or CTA form.
# Leave SMTP_HOST empty to disable email notifications.
# ==========================================================
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=notifications@sitebotstudio.com
SMTP_FROM_NAME=SiteBot Studio
NOTIFY_EMAIL=you@example.com

# ==========================================================
# WhatsApp Lead Notifications (via any HTTP gateway)
# The app POSTs a JSON payload to WHATSAPP_API_URL when a lead is captured.
# Leave WHATSAPP_API_URL empty to disable WhatsApp notifications.
# ==========================================================
WHATSAPP_API_URL=https://your-whatsapp-gateway.example/api/send
WHATSAPP_TOKEN=your_whatsapp_gateway_token
WHATSAPP_FROM=your_whatsapp_gateway_from
NOTIFY_WHATSAPP=+1234567890

# ==========================================================
# Telegram Lead Notifications
# Send a message to a bot via the public Bot API. Get TELEGRAM_BOT_TOKEN from @BotFather.
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram notifications.
# ==========================================================
TELEGRAM_BOT_TOKEN=123456789:AAEyourTelegramBotToken
TELEGRAM_CHAT_ID=your_telegram_receiver_chat_id

# ==========================================================
# PayPal Pro Upgrade (REST API)
# PAYPAL_MODE must be "sandbox" or "live".
# Client ID/Secret from https://developer.paypal.com -> Apps & Credentials.
# ==========================================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_RETURN_URL=http://localhost:3000/dashboard
PAYPAL_CANCEL_URL=http://localhost:3000/pricing
